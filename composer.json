{
    "name": "pterodactyl-serversuite/serversuite",
    "description": "A mod management plugin for Pterodactyl and Pelican panels.",
    "type": "library",
    "version": "0.17.3",
    "license": "MIT",
    "authors": [
        {
            "name": "Your Name",
            "email": "you@example.com"
        }
    ],
    "require": {
        "php": "^8.2 || ^8.3",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0",
        "illuminate/http": "^11.0 || ^12.0",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/events": "^11.0 || ^12.0",
        "symfony/yaml": "^6.0 || ^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.0 || ^3.0",
        "orchestra/testbench": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "ServerSuite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ServerSuite\\Tests\\": "tests/",
            "Pterodactyl\\Models\\": "tests/Fakes/Pterodactyl/Models/",
            "Pterodactyl\\Facades\\": "tests/Fakes/Pterodactyl/Facades/",
            "Pterodactyl\\Http\\Requests\\": "tests/Fakes/Pterodactyl/Http/Requests/",
            "Pterodactyl\\Services\\Acl\\": "tests/Fakes/Pterodactyl/Services/Acl/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ServerSuite\\Providers\\ModManagerServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
