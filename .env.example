# ─────────────────────────────────────────────────────────
# PterodactylModManager — add the following to your .env
# ─────────────────────────────────────────────────────────

# Panel variant: 'auto' (recommended), 'pterodactyl', or 'pelican'
MOD_MANAGER_PANEL=auto

# CurseForge API key (required to use CurseForge; get one at https://console.curseforge.com/)
CURSEFORGE_API_KEY=

# Enable/disable individual repositories globally (per-server overrides exist in the UI)
MOD_MANAGER_MODRINTH_ENABLED=true
MOD_MANAGER_CURSEFORGE_ENABLED=true
MOD_MANAGER_HANGAR_ENABLED=true

# Repository API base URLs (only change these if you use mirrors or self-hosted instances)
# MOD_MANAGER_MODRINTH_URL=https://api.modrinth.com/v2
# MOD_MANAGER_CURSEFORGE_URL=https://api.curseforge.com/v1
# MOD_MANAGER_HANGAR_URL=https://hangar.papermc.io/api/v1

# Disk used for staging mod files before uploading them to game servers
MOD_MANAGER_TMP_DISK=local

# Seconds to wait for a mod file to download from a repository CDN
MOD_MANAGER_DOWNLOAD_TIMEOUT=60

# Cron expression for the update-check scheduler (default: 3 AM daily)
MOD_MANAGER_UPDATE_INTERVAL="0 3 * * *"

# When true, update checks only flag available updates — they do not apply them.
# Admins use the bulk-update button in the UI.
MOD_MANAGER_NOTIFY_ONLY=true

# Public status cards per subdomain (/status/<fqdn>); false hides them all.
# SERVERSUITE_STATUS_CARDS=true
# Seconds a status ping is cached, however many people view the card.
# SERVERSUITE_STATUS_CARD_CACHE=30
